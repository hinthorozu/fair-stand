+def test_blank_item_key_is_selectable_fixed_line_and_duplicate_item_key_is_rejected(client, auth_headers):
+    category = client.post(
+        "/api/v1/cost-catalog/categories",
+        headers=auth_headers,
+        json={"name": "Sabit", "slug": "sabit", "description": None},
+    )
+    assert category.status_code == 201, category.text
+    category_id = category.json()["id"]
+
+    fixed = client.post(
+        "/api/v1/cost-catalog/products",
+        headers=auth_headers,
+        json={
+            "category_id": category_id,
+            "name": "Nakliye",
+            "slug": "nakliye",
+            "unit": "Adet",
+            "unit_price": "1",
+            "currency": "TL",
+            "item_key": "  ",
+        },
+    )
+    assert fixed.status_code == 201, fixed.text
+    assert fixed.json()["item_key"] is None
+
+    mapped = client.post(
+        "/api/v1/cost-catalog/products",
+        headers=auth_headers,
+        json={
+            "category_id": category_id,
+            "name": "Panel",
+            "slug": "panel",
+            "unit": "Adet",
+            "unit_price": "10",
+            "currency": "TL",
+            "item_key": "panel_197",
+        },
+    )
+    assert mapped.status_code == 201, mapped.text
+    assert mapped.json()["item_key"] == "panel_197"
+
+    duplicate = client.post(
+        "/api/v1/cost-catalog/products",
+        headers=auth_headers,
+        json={
+            "category_id": category_id,
+            "name": "Panel kopya",
+            "slug": "panel-kopya",
+            "unit": "Adet",
+            "unit_price": "11",
+            "currency": "TL",
+            "item_key": "panel_197",
+        },
+    )
+    assert duplicate.status_code == 409, duplicate.text
