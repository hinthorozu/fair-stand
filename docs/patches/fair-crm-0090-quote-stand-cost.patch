+def _cost_total_text(snapshot: dict | None) -> str:
+    if not isinstance(snapshot, dict):
+        return ""
+    total = snapshot.get("total")
+    if not isinstance(total, dict) or total.get("amount") is None or not total.get("currency"):
+        return ""
+    return f"{total['amount']} {total['currency']}"
+
+
+def _cost_lines_html(snapshot: dict | None) -> str:
+    if not isinstance(snapshot, dict):
+        return ""
+    rows: list[str] = []
+    for line in snapshot.get("lines") or []:
+        if not isinstance(line, dict):
+            continue
+        if line.get("status") == "priced" and line.get("lineTotal") is not None:
+            amount = f"{line.get('lineTotal')} {line.get('currency') or ''}".strip()
+        else:
+            amount = _COST_STATUS_LABELS.get(str(line.get("status") or ""), "")
+        name = html.escape(str(line.get("name") or line.get("itemKey") or ""))
+        quantity = html.escape(
+            f"{line.get('quantity') or ''} {line.get('bomUnit') or line.get('costUnit') or ''}".strip()
+        )
+        rows.append(f"<tr><td>{name}</td><td>{quantity}</td><td>{html.escape(amount)}</td></tr>")
+    if not rows:
+        return ""
+    note = "<p>Karışık para birimi; tek toplam yok.</p>" if snapshot.get("mixedCurrency") else ""
+    return (
+        "<table><thead><tr><th>Kalem</th><th>Miktar</th><th>Tutar</th></tr></thead><tbody>"
+        + "".join(rows)
+        + "</tbody></table>"
+        + note
+    )
