+def test_quote_stores_stand_snapshot_without_inventing_a_zero_total(client, auth_headers):
+    customer = client.post(
+        "/api/v1/customers",
+        headers=auth_headers,
+        json={"display_name": "Stand Müşteri", "status": "active"},
+    )
+    fair = client.post("/api/v1/fairs", headers=auth_headers, json={"name": "Stand Fuar"})
+    todo = client.post(
+        "/api/v1/todos",
+        headers=auth_headers,
+        json={
+            "title": "Stand teklifi",
+            "category": "teklif",
+            "customer_id": customer.json()["id"],
+            "source_fair_id": fair.json()["id"],
+        },
+    )
+    project_id = "11111111-1111-4111-8111-111111111111"
+    template = client.post(
+        "/api/v1/quote-templates",
+        headers=auth_headers,
+        json={
+            "name": "Stand Teklifi",
+            "source_code": (
+                "<p>{{stand_project_id}}</p><p>{{cost_total}}</p>{{cost_lines}}"
+                "<img src=\"{{stand_render_url}}\">"
+            ),
+        },
+    )
+    assert template.status_code == 201, template.text
+    snapshot = {
+        "projectId": project_id,
+        "mixedCurrency": False,
+        "total": None,
+        "lines": [
+            {"source": "bom", "status": "unmapped", "name": "Panel", "itemKey": "panel_197", "quantity": "2", "bomUnit": "adet", "lineTotal": None},
+        ],
+    }
+    created = client.post(
+        f"/api/v1/quotes/todo/{todo.json()['id']}",
+        headers=auth_headers,
+        json={
+            "template_id": template.json()["id"],
+            "quote_date": "2026-09-27",
+            "status": "draft",
+            "selected_items": [],
+            "stand_project_id": project_id,
+            "cost_snapshot": snapshot,
+            "stand_render_url": f"/api/v1/fair-stand/projects/{project_id}/assets/22222222-2222-4222-8222-222222222222",
+        },
+    )
+    assert created.status_code == 201, created.text
+    body = created.json()
+    assert body["stand_project_id"] == project_id
+    assert body["cost_snapshot"]["total"] is None
+    rendered = client.get(f"/api/v1/quotes/todo/{todo.json()['id']}/render", headers=auth_headers)
+    assert rendered.status_code == 200, rendered.text
+    html = rendered.json()["html"]
+    assert project_id in html
+    assert "eşleşmedi" in html
+    assert ">0<" not in html
+    assert "0 TL" not in html
+    assert "/assets/22222222-2222-4222-8222-222222222222" in html
