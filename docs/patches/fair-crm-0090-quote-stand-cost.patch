+function costTotalLabel(snapshot: Record<string, unknown> | null) {
+  const total = snapshot?.total as { amount?: string; currency?: string } | undefined;
+  if (!total?.amount || !total.currency) return "";
+  return `${total.amount} ${total.currency}`;
+}
+
+async function inlineStandRender(html: string, url: string | null) {
+  if (!html || !url || !html.includes(url)) return html;
+  const response = await fetchWithTimeout(url, { headers: buildApiHeaders() });
+  if (!response.ok) return html;
+  const blob = await response.blob();
+  const dataUrl = await new Promise<string>((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result || ""));
+    reader.onerror = () => reject(reader.error);
+    reader.readAsDataURL(blob);
+  });
+  return html.split(url).join(dataUrl);
+}
