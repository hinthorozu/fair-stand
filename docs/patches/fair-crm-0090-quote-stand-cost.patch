+        sqlite_where=sa.text("item_key IS NOT NULL"),
+    )
+
+
+def downgrade() -> None:
+    op.drop_index("uq_cost_product_org_item_key", table_name="crm_cost_products")
+    op.drop_column("crm_cost_products", "item_key")
+    op.drop_column("crm_quotes", "stand_render_url")
+    op.drop_column("crm_quotes", "cost_snapshot")
+    op.drop_column("crm_quotes", "stand_project_id")
