      "test/projectImportFlow.test.js"
    ],
    "fullSuite": true,
    "build": true,
    "e2e": {
      "required": true,
      "targeted": [
        "e2e/f023-atomic-project-delete.spec.mjs"
      ],
      "reason": "Project deletion is browser-visible persistence/storage behavior. Chromium must prove that deleting a project removes both its project record and its image assets while leaving another project's data intact."
    }
  },
  "risk": {
    "level": "medium",
    "notes": "The deletion boundary moves from two independent transactions to one cross-store transaction. Main risks are deleting assets belonging to another project, failing to delete all target assets, or changing failed-import cleanup behavior. Targeted storage/integration and browser tests cover those boundaries."
  },
  "migration": {
    "required": false,
    "notes": "No IndexedDB version, object-store schema, project schema, or persisted record shape changes."
  },
  "rollback": "Revert the atomic project+asset deletion API, restore the previous two-step main deletion/cleanup calls, and remove the targeted regressions."
