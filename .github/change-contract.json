      "reason": "Catalog visibility, real drag/drop, canonical state persistence, successful plastic_trash_bin.glb scene load, rendered-module interaction, Add picker admission, and automatic depot composition are browser-visible behavior and require Chromium coverage."
    }
  },
  "risk": {
    "level": "medium",
    "notes": "Primary risks are renderer dispatch drift, failed GLB loading/normalization, canonical type loss, or fixture placement regressions. Targeted unit coverage locks identity/behavior and Chromium now verifies the real scene renderer completes the trash-bin GLB load after drag/drop."
  },
  "migration": {
    "required": false,
    "notes": "No persisted schema version change is introduced. Existing saved trash-bin instances remain readable; newly created trash-bin instances persist the canonical plastic-trash-bin type."
  },
  "rollback": "Revert the trash-bin catalog identity, renderer dispatch, catalog preview styling and their regressions if the corrective patch causes a runtime regression."
