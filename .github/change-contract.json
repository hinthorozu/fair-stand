  "risk": {
    "level": "low",
    "notes": "Canonicalizes three existing shelf production Items and their verified 38 cm depth plus user-confirmed 18 mm sunta/white product defaults. Renderer thickness changes from the old implicit 3 cm value to the real 1.8 cm Item value; parent module behavior and recipe quantities remain unchanged."
  },
  "migration": {
    "required": false,
    "notes": "No persisted project schema migration is required; shelf leaf metadata/defaultColor is not duplicated into project state and existing parent shelf module snapshots remain valid."
  },
  "rollback": "Restore shelf_100/shelf_150/shelf_200 legacy partId definitions and recipe entries, restore catalog shelf projection/thickness constants and renderer gray shelf color, remove the shelf Item resolver/docs/tests, and leave parent shelf state/behavior/recipe quantities unchanged."
}
