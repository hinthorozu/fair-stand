  "risk": {
    "level": "medium",
    "notes": "The 5 cm width and 7 cm depth increase changes the Mini Buzdolabı footprint used by free placement and automatic-depot composition. The height remains 66 cm and no placement algorithm or persisted schema is changed."
  },
  "migration": {
    "required": false,
    "notes": "No project-state schema changes. Existing saved Mini Buzdolabı instances keep their stored dimensions; newly created/reconstructed instances use the new 50x50x66 nominal dimensions. A global historical-state migration would belong to the separate project migration work rather than this dimension update."
  },
  "rollback": "Revert the Mini Buzdolabı catalog/state/depot dimension commits and targeted regressions if the 50x50 footprint causes an unacceptable placement or composition regression."
