      ],
      "reason": "Browser drag/drop must load the real plastic_trash_bin.glb and the actual scene-render completion event must confirm the embedded Sphere_1 branch was pruned before fitting."
    }
  },
  "risk": {
    "level": "medium",
    "notes": "The change is isolated to plastic-trash-bin GLB cleanup. Indoor plants keep their existing renderer behavior. The main regression risk is failing to prune the asset-specific Sphere_1 node before bounds fitting."
  },
  "migration": {
    "required": false,
    "notes": "No persisted schema version change is introduced. Existing saved trash-bin instances remain readable; newly created trash-bin instances persist the canonical plastic-trash-bin type."
  },
  "rollback": "Revert the plastic-trash-bin Sphere_1 pruning and its browser regression if the source asset is replaced with a cleaned GLB that no longer contains that node."
