    ],
    "fullSuite": true,
    "build": true,
    "e2e": {
      "required": true,
      "targeted": [
        "e2e/wall-media-items-contract.spec.mjs",
        "e2e/plastic-trash-bin-module.spec.mjs"
      ],
      "reason": "Catalog drag-drop, runtime state and persistence for the five wall-media cards are browser-visible; the E2E drags each card and verifies the saved project carries the canonical itemKey/catalogKey plus the grid parameters. The same uncommitted working set also carries the plastic-trash-bin catalog-preview silhouette change, whose browser-visible catalog/Add cards are covered by its dedicated spec."
    }
  },
  "risk": {
    "level": "medium",
    "notes": "Central catalog/state/Item source-of-truth refactor. Runtime dimensions, wall-media BOM policy, wall-overlay placement and the TV renderer are held at parity; risk is confined to identity routing and legacy-project itemKey hydration, covered by unit + E2E."
  },
  "migration": {
    "required": false,
    "notes": "No stored-shape rewrite is forced. Legacy projects still resolve their canonical catalogKey through resolveModuleCatalogKey and now also hydrate itemKey via normalizeModuleItemState on load; no dual-write and no persisted migration step is required."
  },
  "rollback": "Revert this change set to restore src/tvConfig.js as the wall-media source-of-truth and the previous catalog/state derivation."
}
