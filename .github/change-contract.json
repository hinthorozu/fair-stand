      ],
      "reason": "The repository change gate classifies production/BOM/renderer changes as browser-impacting, so the existing module-construction E2E is required."
    }
  },
  "risk": {
    "level": "low",
    "notes": "Canonicalizes one existing showcase leaf Item and corrects its renderer geometry from implicit 87.3 × 26.5 × 1.8 cm fit values to the user-verified 87.3 × 28.5 × 0.6 cm product dimensions. Parent showcase behavior and existing BOM quantities are preserved; glass appearance changes are centralized renderer defaults with explicit table/panel/projector boundaries."
  },
  "migration": {
    "required": false,
    "notes": "No persisted project schema migration is required; glass_shelf is a leaf production Item and canonical product metadata is not copied into project state."
  },
  "rollback": "Restore glass_shelf legacy partId definition and recipe entries, restore showcase procedural shelf dimensions/material literals and prior distributed glass appearance literals, remove glass_shelf definition/regression coverage, and leave parent showcase state/behavior/BOM quantities unchanged."
}
