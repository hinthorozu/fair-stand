  "risk": {
    "level": "medium",
    "notes": "CRM leftover catalog tables must be dropped only after Stand DB has the dump. Same-origin proxy must stay ahead of /api. Orphan CRM uvicorn workers can keep serving deleted routes."
  },
  "migration": {
    "required": true,
    "notes": "Stand Alembic 0001_fair_stand_schema on database fair_stand. CRM Alembic 0089_drop_fair_stand_tables removes leftover fair_crm.fair_stand_* tables. Configurator IndexedDB is unchanged."
  },
  "rollback": "Restore CRM catalog router only together with restoring fair_crm.fair_stand_* from backup. Do not reintroduce a static ITEMS master. Disable nginx/vite /api/v1/fair-stand proxy to :8002 only after CRM hosts the routes again."
